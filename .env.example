# Copy to .env and adjust. Never commit real secrets.

# --- API (Go) ---
APP_ENV=development
API_ADDR=:8080
DATABASE_URL=postgres://listou:listou@localhost:5432/listou?sslmode=disable
PUBLIC_WEB_URL=http://localhost:3000
COOKIE_SECURE=false
SESSION_TTL=720h
RESERVATION_TTL=168h
LOG_LEVEL=info
# Comma-separated overrides, e.g. AI_LIST_BUILDER=true,GROUP_GIFTS=false
FEATURE_FLAGS=

# Affiliate providers (real adapters are not implemented yet; see docs/affiliate-providers.md)
# AMAZON_ASSOCIATES_TAG=
# MERCADO_LIVRE_AFFILIATE_ID=
# SHOPEE_AFFILIATE_ID=

# Error tracking (optional)
# SENTRY_DSN=

# --- Web (Next.js) ---
API_URL=http://localhost:8080
NEXT_PUBLIC_SITE_URL=http://localhost:3000
